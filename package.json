{
  "name": "palbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "帕鲁服务管理面板与配置编辑工作台",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "bash ./dev.sh --no-watch",
    "dev": "bash ./dev.sh",
    "dev:managed": "bash ./dev.sh",
    "start:frontend": "node frontend/index.js",
    "start:backend": "node backend/index.js",
    "dev:frontend": "node --watch frontend/index.js",
    "dev:backend": "node --watch backend/index.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "node tests/e2e/browser.cjs",
    "test:e2e:totp": "node tests/e2e/totp.cjs",
    "test:e2e:password": "node tests/e2e/password.cjs",
    "test:e2e:username": "node tests/e2e/username.cjs",
    "test:e2e:initial": "node tests/e2e/initial-configuration.cjs",
    "test:e2e:managed": "node tests/e2e/management.cjs",
    "test:e2e:backups": "node tests/e2e/backups.cjs",
    "test:e2e:logs": "node tests/e2e/logs.cjs",
    "test:e2e:on-demand": "node tests/e2e/on-demand.cjs",
    "test:e2e:running": "node tests/e2e/running-config.cjs",
    "test:e2e:reset": "node tests/e2e/save-reset.cjs",
    "test:e2e:imports": "node tests/e2e/save-imports.cjs",
    "test:browser": "npm run test:e2e"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
